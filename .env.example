# Browser keys (safe to expose — protected by Row Level Security)
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI keys do NOT go here. They are Supabase secrets, set with:
#   supabase secrets set AI_PROVIDER=anthropic AI_API_KEY=sk-... [AI_MODEL=...] [AI_BASE_URL=https://your-gateway]
# AI_PROVIDER: anthropic | openai | gemini
