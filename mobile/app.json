{
  "expo": {
    "name": "Fitoor",
    "slug": "fitoor",
    "version": "1.0.0",
    "scheme": "fitoor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "life.fitoor.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "life.fitoor.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12261B"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitoor uses your photos so you can log meals, scale readings and lab reports.",
          "cameraPermission": "Fitoor uses the camera so you can snap your meal, your scale or a gym machine.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EEF6E8"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "36b88a53-7d74-4498-b9b8-e8fc9f3512a1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "mr.himanshuahuja",
    "updates": {
      "url": "https://u.expo.dev/36b88a53-7d74-4498-b9b8-e8fc9f3512a1"
    }
  }
}
